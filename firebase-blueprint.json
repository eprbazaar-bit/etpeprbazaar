        "pageId": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 180 },
        "details": { "type": "string", "maxLength": 500 },
        "actorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "pageId", "slug", "details", "actorUid", "actorEmail", "createdAt"]
    }
  },
