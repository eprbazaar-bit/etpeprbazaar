        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "canonicalDomain", "sitemapStatus", "totalUrls", "lastRegeneratedByUid", "lastRegeneratedAt", "updatedAt"]
    },
    "SeoChangeLog": {
      "title": "SeoChangeLog",
      "description": "Immutable log of SEO metadata updates, page publish state changes, and sitemap regenerations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
