        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "categoryId", "categoryName", "financialYear", "unit", "rate", "published", "updatedByUid", "createdAt", "updatedAt"]
    },
