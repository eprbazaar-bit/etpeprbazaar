        "categoryId": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 100 },
        "notificationType": { "type": "string", "enum": ["buyer_requirement", "seller_listing"] },
        "subject": { "type": "string", "maxLength": 240 },
        "status": { "type": "string", "enum": ["pending", "sent", "failed"] },
        "attemptCount": { "type": "number" },
        "provider": { "type": "string", "enum": ["resend", "sendgrid", "smtp", "none"] },
        "providerMessageId": { "type": "string", "maxLength": 200 },
        "providerResponse": { "type": "string", "maxLength": 400 },
        "errorMessage": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "sentAt": { "type": "string", "format": "date-time" },
        "lastAttemptAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "listingId", "recipientUserId", "recipientEmail", "recipientRole", "category", "notificationType", "status", "createdAt"]
    },
    "MarketRate": {
      "title": "MarketRate",
      "description": "Computed market rate summary per category and financial year from real Firestore listings/transactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryId": { "type": "string", "maxLength": 64 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "financialYear": { "type": "string", "maxLength": 20 },
        "unit": { "type": "string", "maxLength": 16 },
        "lowestAskingRate": { "type": "number" },
        "highestAskingRate": { "type": "number" },
        "indicativeRate": { "type": "number" },
        "lastTradedRate": { "type": "number" },
        "availableQty": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "categoryId", "categoryName", "financialYear", "unit", "availableQty", "updatedAt"]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "Completed transaction ledger record used for actual Last Traded Rate discovery.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "maxLength": 64 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "financialYear": { "type": "string", "maxLength": 20 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 16 },
        "tradedRate": { "type": "number" },
        "totalValue": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderId", "categoryId", "categoryName", "financialYear", "quantity", "unit", "tradedRate", "totalValue", "completedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and operational audit trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "maxLength": 120 },
        "target": { "type": "string", "maxLength": 120 },
        "details": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "actorEmail", "role", "action", "target", "details", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Marketplace-wide rate matching tolerances, brokerage, and tax configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "defaultBrokeragePercent": { "type": "number" },
        "gstPercent": { "type": "number" },
        "matchingRateTolerancePercent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "defaultBrokeragePercent", "gstPercent", "matchingRateTolerancePercent", "updatedAt"]
    },
    "PublishedEprRate": {
      "title": "PublishedEprRate",
      "description": "Admin-approved EPR category rate displayed in the website header ticker and rate board.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100, "pattern": "^[a-zA-Z0-9_\\-]+$" },
