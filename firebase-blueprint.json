        "metaDescription": { "type": "string", "maxLength": 320 },
        "canonicalUrl": { "type": "string", "maxLength": 260 },
        "robots": { "type": "string", "enum": ["index, follow", "noindex, nofollow"] },
        "ogTitle": { "type": "string", "maxLength": 120 },
        "ogDescription": { "type": "string", "maxLength": 320 },
        "ogImage": { "type": "string", "maxLength": 400 },
        "twitterCard": { "type": "string", "enum": ["summary_large_image", "summary"] },
        "published": { "type": "boolean" },
        "isSystemPage": { "type": "boolean" },
        "aiDraftSeoTitle": { "type": "string", "maxLength": 120 },
        "aiDraftMetaDescription": { "type": "string", "maxLength": 320 },
        "aiDraftApproved": { "type": "boolean" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "pageType", "pageTitle", "contentSummary", "seoTitle", "metaDescription", "canonicalUrl", "robots", "ogTitle", "ogDescription", "ogImage", "twitterCard", "published", "isSystemPage", "updatedByUid", "createdAt", "updatedAt"]
    },
    "SeoSettings": {
      "title": "SeoSettings",
      "description": "Sitemap status, canonical domain configuration, and last regeneration metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
